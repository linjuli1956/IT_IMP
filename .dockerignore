# Docker 构建上下文来自项目根目录，只保留 web 源码和 Docker 部署脚本。

# 依赖与构建产物
**/node_modules
web/.nuxt
web/.output
web/.nitro
web/.cache
web/generated
desktop/frontend/dist
desktop/build

# 运行数据与敏感配置
data
web/prisma/seed.ts
**/.env
**/.env.*
**/config.json

# 不参与 Docker 构建的项目内容
.git
.qoder
desktop
docs
deploy/*
!deploy/docker/
deploy/docker/*
!deploy/docker/Dockerfile
!deploy/docker/docker-entrypoint.sh

# 文档与临时文件
**/*.md
**/*.log
**/*.tmp
