# IT_IMP Docker Compose 配置
# 复制为 .env 后即可部署。除密码和数据目录外，其余配置一般无需修改。

# 持久化数据总目录：MySQL 保存到 ${DATA_DIR}/mysql，上传文件保存到 ${DATA_DIR}/app。
# Linux/NAS 示例：/vol1/1000/docker/IT_IMP_docker/data
DATA_DIR=./data

# 对外访问端口。若沿用旧部署端口，可改为 7000。
WEB_PORT=3000

# MySQL 仅绑定宿主机本机，避免对公网暴露；容器内 Web 始终连接 db:3306。
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_PORT=3306
MYSQL_IMAGE=mysql:8.0
MYSQL_DATABASE=it_imp
MYSQL_TIME_ZONE=+08:00

# 必须修改为你自己的随机强密码与 JWT 密钥；此文件不会提交到 Git。
MYSQL_ROOT_PASSWORD=change-this-mysql-root-password
JWT_SECRET=change-this-to-a-long-random-jwt-secret

# Web 连接内置 MySQL。DATABASE_PASSWORD 留空时自动使用 MYSQL_ROOT_PASSWORD。
DATABASE_HOST=db
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_NAME=it_imp

# 平台与时区
NUXT_PUBLIC_APP_NAME=综合管理平台
TZ=Asia/Shanghai
PORT=3000
NODE_IMAGE=node:24-alpine
# 默认直接从 GitHub Container Registry 拉取正式镜像；无需下载源码或构建。
IT_IMP_IMAGE=ghcr.io/linjuli1956/it-imp-web:latest

# 仅首次空数据库时生效；首次登录后请立即修改密码。
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=123456
