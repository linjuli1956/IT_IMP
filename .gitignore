# ===========================================
# IT_IMP - .gitignore
# 公开仓库：排除内部数据、配置、构建产物和私人笔记
# ===========================================

# ---- 依赖目录 ----
node_modules/
desktop/frontend/node_modules/

# ---- Nuxt 构建产物 ----
.nuxt/
.output/
dist/

# ---- Wails/Go 构建产物 ----
desktop/build/bin/
desktop/build/windows/
desktop/build/bin/config.json
*.exe

# ---- 运行时数据（部署时生成）----
# 仅保留 .gitkeep 维持目录结构，其余内容一律忽略
data/*
!data/.gitkeep
!data/uploads
!data/logs
data/uploads/*
!data/uploads/.gitkeep
!data/uploads/invoices
!data/uploads/details
!data/uploads/contracts
data/uploads/invoices/*
!data/uploads/invoices/.gitkeep
data/uploads/details/*
!data/uploads/details/.gitkeep
data/uploads/contracts/*
!data/uploads/contracts/.gitkeep
data/logs/*
!data/logs/.gitkeep

# ---- 日志 ----
*.log
logs/
!logs/.gitkeep

# ---- 环境变量与密钥 ----
.env
.env.*
!.env.example
config.json
*.pem
*.key
*.p12
*.cert

# ---- 系统文件 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- IDE ----
.vscode/
.idea/
*.swp
*.swo

# ---- 临时文件 ----
*.tmp
*.bak
*~

# ---- 内部文档（含真实业务数据，不入公开仓库）----
docs/副本*.xlsx
docs/*.pdf
docs/前端规划文档.md
docs/开发习惯与项目模板.md
docs/开发计划文档.md
docs/开源准备清单.md
docs/数据库字典.md
docs/计提费用分摊规则引擎_开发要求.md
docs/项目目录文档与业务逻辑说明.md
docs/项目立项文档.md

# ---- 数据库 Seed（公开仓库不预置业务数据）----
web/prisma/seed.ts
web/prisma/seed.demo.ts

# ---- 上传文件 / OCR 临时文件 / 导出文件 ----
web/public/mock-invoices/
web/data/uploads/
web/data/exports/
web/data/ocr-temp/

# ---- 数据库备份 ----
*.sql.bak
*.sql.gz
*.dump

# ---- Bun 运行时（随包发布，不入仓库）----
desktop/build/bin/bun/

# ---- Docker 运行时数据与环境文件 ----
deploy/docker/data/
deploy/docker/.env.docker
deploy/docker/secrets/*.txt
!deploy/docker/secrets/*.txt.example

# ---- Qoder 缓存 ----
.qoder/
