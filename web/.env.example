# 数据库连接字符串
# 注意：密码不在此文件中保存，由 EXE 配置工具通过环境变量注入
# EXE 启动 Web 服务和执行 Prisma 命令时会设置 DATABASE_URL 和各连接参数
DATABASE_URL="mysql://root:PASSWORD_PLACEHOLDER@REMOTE_HOST:3306/it_imp"

# Prisma Client 驱动适配器使用的单独连接参数
# 同样由 EXE 运行时注入，不在此文件保存实际密码
DATABASE_HOST="REMOTE_HOST"
DATABASE_PORT=3306
DATABASE_USER="root"
DATABASE_PASSWORD="PASSWORD_PLACEHOLDER"
DATABASE_NAME="it_imp"

# JWT 密钥（后续阶段使用）
JWT_SECRET="CHANGE_ME_TO_RANDOM_SECRET"

